{
  "name": "@mikumon/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --target bun-windows-x64 --outfile ../../dist/mikumon-api src/index.ts",
    "start": "bun run src/index.ts",
