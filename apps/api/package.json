    "test:watch": "bun test --watch src/__tests__",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/jwt": "^1.1.0",
    "@elysiajs/swagger": "^1.1.0",
    "@mikumon/db": "workspace:*",
    "@mikumon/shared-types": "workspace:*",
    "@mikumon/utils": "workspace:*",
    "@mikumon/validation": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "elysia": "^1.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
