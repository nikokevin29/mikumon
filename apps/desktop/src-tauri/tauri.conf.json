{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mikumon",
  "version": "1.0.0",
  "identifier": "com.mikumon.app",
  "build": {
    "frontendDist": "../../web/.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Mikumon - ISP Management",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mikumon-api"
    ],
    "resources": {
      "migrations/*": "migrations"
    }
  }
}
